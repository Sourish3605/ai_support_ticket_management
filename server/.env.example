# ==========================================
# SupportPilot Backend Environment Config
# ==========================================

# 1. Persistent Database (PostgreSQL URL on Render / Local SQLite)
DATABASE_URL=

# 2. MongoDB Database URI
MONGO_URI=

# 3. Django Security
DEBUG=True
SECRET_KEY=your-django-secret-key-here
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=https://ai-support-ticket-management.vercel.app,http://localhost:5173,http://localhost:5174

# 4. Optional Cloud Email Gateway
RESEND_API_KEY=
BREVO_API_KEY=
